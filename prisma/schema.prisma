generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GURU
  PROKTOR
  SISWA
}

enum TipeSoal {
  PG           // Pilihan Ganda Tunggal
  PG_KOMPLEKS  // Pilihan Ganda Lebih dari 1 jawaban
  BENAR_SALAH  // Pernyataan Benar/Salah
  MENJODOHKAN  // Pasangan Premis & Respon
  ISIAN        // Isian Singkat
  ESAI         // Uraian
}

enum StatusUjian {
  DRAFT
  DIJADWALKAN
  SEDANG_BERJALAN
  SELESAI
  NONAKTIF
}

enum StatusPeserta {
  BELUM_MULAI
  SEDANG_MENGERJAKAN
  SELESAI
  TERKUNCI
  RESET_LOGIN
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  password      String
  name          String
  role          Role      @default(SISWA)
  nis           String?   @unique
  nisn          String?   @unique
  nip           String?   @unique
  jenisKelamin  String?   // L / P
  foto          String?
  nomorPeserta  String?   @unique // Dipertahankan sebagai alias opsional
  ruangUjian    String?
  sesiUjian     Int?      @default(1)
  
  // Relasi Siswa ke Kelas
  kelasId       String?
  kelas         Kelas?    @relation(fields: [kelasId], references: [id])
  
  // Relasi Guru
  mataPelajaran GuruMataPelajaran[]
  bankSoalList  BankSoal[]
  
  // Relasi Peserta Ujian
  pesertaUjian  PesertaUjian[]
  logs          LogAktivitasUjian[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Kelas {
  id        String   @id @default(cuid())
  nama      String   @unique // Contoh: X-MIPA 1, XI-IPS 2, XII-F1
  tingkat   Int      // 10, 11, 12
  jurusan   String   // MIPA, IPS, UMUM, dsb.
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MataPelajaran {
  id           String              @id @default(cuid())
  kode         String              @unique // Contoh: MTK-10, BIND-12
  nama         String              // Matematika, Bahasa Indonesia
  gurus        GuruMataPelajaran[]
  bankSoalList BankSoal[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model GuruMataPelajaran {
  id              String        @id @default(cuid())
  guruId          String
  mataPelajaranId String
  guru            User          @relation(fields: [guruId], references: [id], onDelete: Cascade)
  mataPelajaran   MataPelajaran @relation(fields: [mataPelajaranId], references: [id], onDelete: Cascade)

  @@unique([guruId, mataPelajaranId])
}

model BankSoal {
  id              String        @id @default(cuid())
  kodeBank        String        @unique // Contoh: BS-MTK-X-PAS
  nama            String        // Bank Soal PAS Matematika Kelas X
  tingkat         Int           // 10, 11, 12
  jurusan         String?
  durasiMenit     Int           @default(90) // Durasi standar pengerjaan (menit)
  
  // Nilai Standar Bank Soal
  kkm             Float         @default(75.0) // Kriteria Ketuntasan Minimal
  nilaiMinimal    Float         @default(0.0)  // Nilai minimum (biasanya 0)
  nilaiMaksimal   Float         @default(100.0) // Nilai maksimum (biasanya 100)
  
  mataPelajaranId String
  mataPelajaran   MataPelajaran @relation(fields: [mataPelajaranId], references: [id])
  
  pembuatId       String
  pembuat         User          @relation(fields: [pembuatId], references: [id])
  
  soalList        Soal[]
  ujianList       Ujian[]
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Soal {
  id           String           @id @default(cuid())
  bankSoalId   String
  bankSoal     BankSoal         @relation(fields: [bankSoalId], references: [id], onDelete: Cascade)
  
  nomorUrut    Int              @default(1)
  tipeSoal     TipeSoal         @default(PG)
  pertanyaan   String           @db.Text
  mediaAudio   String?          // URL atau path audio untuk listening
  mediaGambar  String?          // URL atau path gambar ilustrasi
  bobot        Float            @default(1.0) // Poin / bobot per butir soal
  
  // Opsi untuk PG & PG Kompleks / Pernyataan Benar Salah
  opsiJawaban  OpsiJawaban[]
  
  // Jawaban untuk Isian Singkat & Essay (Kunci teks / rubrik)
  kunciJawabanTeks String?      @db.Text
  
  // Pasangan Menjodohkan (JSON string: [{ left: "...", right: "..." }])
  matchingData     String?      @db.Text

  jawabanPeserta   JawabanPeserta[]
  
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model OpsiJawaban {
  id          String   @id @default(cuid())
  soalId      String
  soal        Soal     @relation(fields: [soalId], references: [id], onDelete: Cascade)
  label       String   // A, B, C, D, E atau 1, 2, 3
  konten      String   @db.Text
  gambar      String?
  isBenar     Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Ujian {
  id                String         @id @default(cuid())
  kodeUjian         String         @unique // Contoh: PAS-2026-MTK
  judul             String         // Penilaian Akhir Semester Ganjil 2026/2027
  deskripsi         String?        @db.Text
  
  bankSoalId        String
  bankSoal          BankSoal       @relation(fields: [bankSoalId], references: [id])
  
  durasiMenit       Int            // Contoh: 90 Menit
  waktuMulai        DateTime       // Jadwal mulai dibuka
  waktuSelesai      DateTime       // Jadwal berakhir
  
  acakSoal          Boolean        @default(true)
  acakOpsi          Boolean        @default(true)
  tampilkanHasil    Boolean        @default(false)
  lockBrowser       Boolean        @default(true) // Mode anti cheat fullscreen
  
  status            StatusUjian    @default(DIJADWALKAN)
  
  pesertaUjian      PesertaUjian[]
  
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model PesertaUjian {
  id              String           @id @default(cuid())
  ujianId         String
  ujian           Ujian            @relation(fields: [ujianId], references: [id], onDelete: Cascade)
  
  siswaId         String
  siswa           User             @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  
  status          StatusPeserta    @default(BELUM_MULAI)
  waktuMulai      DateTime?
  waktuSelesai    DateTime?
  sisaDetik       Int?             // Sync timer
  
  // Nilai Akhir
  nilaiPG         Float            @default(0.0)
  nilaiEsai       Float            @default(0.0)
  nilaiTotal      Float            @default(0.0)
  isKoreksiSelesai Boolean         @default(false)
  
  ipAddress       String?
  userAgent       String?
  
  // Urutan soal teracak khusus untuk peserta ini (JSON Array ID Soal)
  urutanSoalIds   String?          @db.Text
  
  jawabanPeserta  JawabanPeserta[]
  logs            LogAktivitasUjian[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([ujianId, siswaId])
}

model JawabanPeserta {
  id              String         @id @default(cuid())
  pesertaUjianId  String
  pesertaUjian    PesertaUjian   @relation(fields: [pesertaUjianId], references: [id], onDelete: Cascade)
  
  soalId          String
  soal            Soal           @relation(fields: [soalId], references: [id], onDelete: Cascade)
  
  // Jawaban yang dipilih (ID Opsi / Array ID Opsi JSON / Teks Jawaban / JSON Menjodohkan)
  jawabanDipilih  String?        @db.Text
  raguRagu        Boolean        @default(false)
  
  isBenar         Boolean?
  skor            Float          @default(0.0)
  catatanKoreksi  String?        @db.Text

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([pesertaUjianId, soalId])
}

model LogAktivitasUjian {
  id              String         @id @default(cuid())
  pesertaUjianId  String?
  pesertaUjian    PesertaUjian?  @relation(fields: [pesertaUjianId], references: [id], onDelete: Cascade)
  
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  aktivitas       String         // Contoh: "LOGIN", "MULAI_UJIAN", "TAB_SWITCH_ALERT", "FULLSCREEN_EXIT", "SELESAI_UJIAN"
  detail          String?        @db.Text
  
  createdAt       DateTime       @default(now())
}

model PengaturanSistem {
  id              String         @id @default("default-settings")
  schoolName      String         @default("SMA Muhammadiyah 1 Ponorogo")
  appTitle        String         @default("CBT MUHIPO")
  academicYear    String         @default("2026/2027")
  semester        String         @default("Ganjil")
  timezone        String         @default("Asia/Jakarta")
  serverLocation  String         @default("Ponorogo, Jawa Timur")
  logoUrl         String?        @default("/pic_logo.png")
  backgroundUrl   String?        @default("/muhipo-front.jpg")
  timeSyncOffsetMs Int           @default(0) // Koreksi offset milidetik sinkronisasi waktu
  updatedAt       DateTime       @updatedAt
}

